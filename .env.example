# Kopiere diese Datei nach ".env" und passe die Werte an. Die Datei .env nie ins Git hochladen.
PORT=3000
# Pfad der SQLite-Datenbank (relativ zum Projektordner). Leer = backend/database/ismini.db
DB_PATH=
# Nur setzen, wenn der Server hinter einem Proxy läuft (z. B. 1)
TRUST_PROXY=
# Maximum booking requests per IP address in 15 minutes.
BOOKING_RATE_LIMIT_MAX=60
# Maximum confirmed bookings from all clients combined in one rolling minute.
BOOKING_GLOBAL_RATE_LIMIT_MAX=10
# Maximum confirmed bookings per normalized email address in one rolling minute.
BOOKING_EMAIL_RATE_LIMIT_MAX=3
# Required for the admin area. Use a unique password with at least 12 characters.
ADMIN_PASSWORD=
# SMTP settings for guest and hotel booking notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
HOTEL_EMAIL=
